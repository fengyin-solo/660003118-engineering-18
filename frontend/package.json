{
  "name": "regex-visual-debugger",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "validate:templates": "node scripts/validate-templates.mjs",
    "check:lockfile": "node scripts/check-lockfile.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "build:only": "vite build",
    "build": "npm run validate:templates && vue-tsc --noEmit -p tsconfig.json && vite build",
    "check": "node scripts/check.mjs",
    "smoke:dev": "node scripts/smoke-dev.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "vue": "^3.4.0",
    "pinia": "^2.1.7"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vue-tsc": "^2.1.10",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0"
  }
}
