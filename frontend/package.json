{
  "name": "regex-visual-debugger",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/preflight.mjs",
    "dev": "vite --host",
    "prebuild": "node scripts/preflight.mjs",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "validate:templates": "node scripts/validate-templates.mjs",
    "check:lockfile": "node scripts/check-lockfile.mjs",
    "preflight": "node scripts/preflight.mjs",
    "verify": "node scripts/preflight.mjs --ci",
    "deploy": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "vue": "^3.4.0",
    "pinia": "^2.1.7"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vue-tsc": "^2.0.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0"
  }
}
